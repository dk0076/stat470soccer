library(ISAR)
library(dplyr)
library(ggplot2)
library(lpSolve)
# Read the DraftKings data and filter to keep only non-captain (FLEX) players
dk_data <- dk_edm_col %>%
filter(roster_position != "CPT")
# Compute the scatterplot coloring by team abbreviation
q5_plot <- ggplot(dk_data, aes(x = salary, y = avg_points_per_game, color = team_abbrev)) +
geom_point(size = 3, alpha = 0.8) +
theme_minimal() +
labs(title = "DraftKings Salary vs Avg Points per Game (Game 7: COL vs EDM)",
x = "Salary",
y = "Average Points per Game",
color = "Team")
# Display the plot
print(q5_plot)
#Filter out nonstarting goalies while keeping Darcy Kuemper and Mike Smith
dk_data_q6 <- dk_data %>%
filter(!(position %in% c("G", "Goalie") & !(name %in% c("Darcy Kuemper", "Mike Smith"))))
num_players <- nrow(dk_data_q6)
# Maximize aggregate avg_points_per_game
obj_q6 <- dk_data_q6$avg_points_per_game
#Constraints matrix
# - Exactly 6 players total
# - Total Salary <= 50000
# - At least 1 player from Colorado (COL)
# - At least 1 player from Edmonton (EDM)
con_mat_q6 <- matrix(c(
rep(1, num_players),
dk_data_q6$salary,
ifelse(dk_data_q6$team_abbrev == "COL", 1, 0),
ifelse(dk_data_q6$team_abbrev == "EDM", 1, 0)
), nrow = 4, byrow = TRUE)
con_dir_q6 <- c("==", "<=", ">=", ">=")
con_rhs_q6 <- c(6, 50000, 1, 1)
# linear porgramming optimxation
sol_q6 <- lp(direction = "max", objective.in = obj_q6, const.mat = con_mat_q6,
const.dir = con_dir_q6, const.rhs = con_rhs_q6, all.bin = TRUE)
#results
team_q6 <- dk_data_q6[sol_q6$solution == 1, ]
cat("\n--- Question 6 Optimal Team ---\n")
print(team_q6 %>% select(name, team_abbrev, salary, avg_points_per_game))
cat("Expected Points:", sum(team_q6$avg_points_per_game), "\n")
cat("Total Salary:", sum(team_q6$salary), "\n")
#Filter out nonstarting goalies while keeping Darcy Kuemper and Mike Smith
dk_data_q6 <- dk_data %>%
filter(!(position %in% c("G", "Goalie") & !(name %in% c("Darcy Kuemper", "Mike Smith"))))
num_players <- nrow(dk_data_q6)
# Objective Function
obj_q6 <- dk_data_q6$avg_points_per_game
# Build the constraint matrix exactly as described in day26.qmd.txt
con_mat_q6 <- matrix(c(
rep(1, num_players),                           # Row of all ones for number of players
dk_data_q6$salary,                             # Row for player salaries
ifelse(dk_data_q6$team_abbrev == "COL", 1, 0), # Row for Colorado players
ifelse(dk_data_q6$team_abbrev == "EDM", 1, 0)  # Row for Edmonton players
), nrow = 4, byrow = TRUE)
# Set the limits for those constraints (6 players, $50k max, at least 1 from each team)
con_dir_q6 <- c("==", "<=", ">=", ">=")
con_rhs_q6 <- c(6, 50000, 1, 1)
# Run the optimization using the lp function and max/all.bin arguments
sol_q6 <- lp(direction = "max", objective.in = obj_q6, const.mat = con_mat_q6,
const.dir = con_dir_q6, const.rhs = con_rhs_q6, all.bin = TRUE)
# Output the chosen team
team_q6 <- dk_data_q6[sol_q6$solution == 1, ]
#results
team_q6 <- dk_data_q6[sol_q6$solution == 1, ]
cat("\n--- Question 6 Optimal Team ---\n")
print(team_q6 %>% select(name, team_abbrev, salary, avg_points_per_game))
cat("Expected Points:", sum(team_q6$avg_points_per_game), "\n")
cat("Total Salary:", sum(team_q6$salary), "\n")
#Filter out nonstarting goalies while keeping Darcy Kuemper and Mike Smith
dk_data_q6 <- dk_data %>%
filter(!(position %in% c("G", "Goalie") & !(name %in% c("Darcy Kuemper", "Mike Smith"))))
num_players <- nrow(dk_data_q6)
# Objective Function
obj_q6 <- dk_data_q6$avg_points_per_game
# Build the constraint matrix exactly as described in day26.qmd.txt
con_mat_q6 <- matrix(c(
rep(1, num_players),                           # Row of all ones for number of players
dk_data_q6$salary,                             # Row for player salaries
ifelse(dk_data_q6$team_abbrev == "COL", 1, 0), # Row for Colorado players
ifelse(dk_data_q6$team_abbrev == "EDM", 1, 0)  # Row for Edmonton players
), nrow = 4, byrow = TRUE)
# Set the limits for those constraints (6 players, $50k max, at least 1 from each team)
con_dir_q6 <- c("==", "<=", ">=", ">=")
con_rhs_q6 <- c(6, 50000, 1, 1)
# Run the optimization using the lp function and max/all.bin arguments
sol_q6 <- lp(direction = "max", objective.in = obj_q6, const.mat = con_mat_q6,
const.dir = con_dir_q6, const.rhs = con_rhs_q6, all.bin = TRUE)
# Output the chosen team
team_q6 <- dk_data_q6[sol_q6$solution == 1, ]
cat("\n--- Question 6 Optimal Team ---\n")
print(team_q6 %>% select(name, team_abbrev, salary, avg_points_per_game))
cat("Expected Points:", sum(team_q6$avg_points_per_game), "\n")
cat("Total Salary:", sum(team_q6$salary), "\n")
con_mat_q7 <- con_mat_q6
con_dir_q7 <- con_dir_q6
# Change the RHS vector so the 3rd value (COL players) is now 4
con_rhs_q7 <- c(6, 50000, 4, 1)
# Run the optimization again with the updated RHS limits
sol_q7 <- lp(direction = "max", objective.in = obj_q6, const.mat = con_mat_q7,
const.dir = con_dir_q7, const.rhs = con_rhs_q7, all.bin = TRUE)
# Output the chosen team
team_q7 <- dk_data_q6[sol_q7$solution == 1, ]
# View the team and calculate the expected points
print(team_q7 %>% select(name, team_abbrev, salary, avg_points_per_game))
sum(team_q7$avg_points_per_game)
#Build the updated constraint matrix
con_mat_q8 <- matrix(c(
rep(1, num_players),                           # 1. Exactly 6 players total
dk_data_q6$salary,                             # 2. Total Salary <= 50000
ifelse(dk_data_q6$team_abbrev == "COL", 1, 0), # 3. At least 1 COL player
ifelse(dk_data_q6$team_abbrev == "EDM", 1, 0), # 4. At least 1 EDM player
ifelse(dk_data_q6$name == "Cale Makar", 1, 0),       # 5. Force Makar
ifelse(dk_data_q6$name == "Nathan MacKinnon", 1, 0)  # 6. Force MacKinnon
), nrow = 6, byrow = TRUE)
#Update the directions and limits for all 6 constraints
con_dir_q8 <- c("==", "<=", ">=", ">=", "==", "==")
con_rhs_q8 <- c(6, 50000, 1, 1, 1, 1)
sol_q8 <- lp(direction = "max", objective.in = obj_q6, const.mat = con_mat_q8,
const.dir = con_dir_q8, const.rhs = con_rhs_q8, all.bin = TRUE)
team_q8 <- dk_data_q6[sol_q8$solution == 1, ]
print(team_q8 %>% select(name, team_abbrev, salary, avg_points_per_game))
sum(team_q8$avg_points_per_game)
