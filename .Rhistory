library(shiny)
library(ggplot2)
library(dplyr)
library(plotly)
library(ISAR)
# Define User Interface (UI)
ui <- fluidPage(
titlePanel("2022 Colorado Avalanche Stats Explorer"),
sidebarLayout(
sidebarPanel(
# Baseline requirement: Select two statistics using the EXACT column names
selectInput("x_var", "Select X-Axis Statistic:",
choices = c("Goals" = "stat_goals",
"Assists" = "stat_assists",
"Points" = "stat_points",
"Shots" = "stat_shots",
"Time on Ice" = "stat_time_on_ice"),
selected = "stat_assists"),
selectInput("y_var", "Select Y-Axis Statistic:",
choices = c("Goals" = "stat_goals",
"Assists" = "stat_assists",
"Points" = "stat_points",
"Shots" = "stat_shots",
"Time on Ice" = "stat_time_on_ice"),
selected = "stat_goals"),
# Interactive Feature 1: Player Highlighter
selectInput("highlight_player", "Select a Player to Highlight:",
choices = c("None", sort(unique(avs_stats_2022$person_full_name))),
selected = "None"),
hr(),
helpText("Hover over the points on the graph to see the specific player's name and stats!")
),
mainPanel(
plotlyOutput("scatterPlot")
)
)
)
# Define Server Logic
server <- function(input, output) {
output$scatterPlot <- renderPlotly({
# Logic to flag if a player is currently selected in the drop-down
plot_data <- avs_stats_2022 %>%
mutate(
is_highlighted = ifelse(person_full_name == input$highlight_player, "Highlighted", "Normal"),
tooltip_text = paste("Player:", person_full_name)
)
# Build the base ggplot
p <- ggplot(plot_data, aes(x = .data[[input$x_var]],
y = .data[[input$y_var]],
text = tooltip_text,
color = is_highlighted,
size = is_highlighted)) +
geom_point(alpha = 0.8) +
# Make normal players maroon, and the highlighted player a large gold dot
scale_color_manual(values = c("Normal" = "maroon", "Highlighted" = "gold")) +
scale_size_manual(values = c("Normal" = 3, "Highlighted" = 6)) +
theme_bw() +
theme(legend.position = "none") +
labs(title = paste("Avalanche Players:", input$y_var, "vs", input$x_var),
x = input$x_var,
y = input$y_var)
# Convert ggplot to an interactive plotly object (Interactive Feature 2)
ggplotly(p, tooltip = c("text", "x", "y"))
})
}
# Run the application
shinyApp(ui = ui, server = server)
