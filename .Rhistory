library(shiny)
library(ggplot2)
library(dplyr)
library(plotly)
library(ISAR) # Contains the avs_stats_2022 dataset
# Define User Interface (UI)
ui <- fluidPage(
titlePanel("2022 Colorado Avalanche Stats Explorer"),
sidebarLayout(
sidebarPanel(
# Baseline requirement: Select two statistics
selectInput("x_var", "Select X-Axis Statistic:",
choices = c("G" = "G", "A" = "A", "PTS" = "PTS", "S" = "S", "TOI" = "TOI"),
selected = "A"),
selectInput("y_var", "Select Y-Axis Statistic:",
choices = c("G" = "G", "A" = "A", "PTS" = "PTS", "S" = "S", "TOI" = "TOI"),
selected = "G"),
# Interactive Feature 1: Position Filter
selectInput("pos_filter", "Filter by Position:",
choices = c("All", "F", "D"),
selected = "All"),
hr(),
helpText("Hover over the points on the graph to see the specific player's name and stats!")
),
mainPanel(
# Output the interactive plotly chart
plotlyOutput("scatterPlot")
)
)
)
# Define Server Logic
server <- function(input, output) {
# Reactive data filtering based on the Position input
filtered_data <- reactive({
data <- avs_stats_2022
if (input$pos_filter != "All") {
data <- data %>% filter(Pos == input$pos_filter)
}
data
})
# Generate the interactive scatterplot
output$scatterPlot <- renderPlotly({
# Build the base ggplot
p <- ggplot(filtered_data(), aes(x = .data[[input$x_var]],
y = .data[[input$y_var]],
text = paste("Player:", Player))) +
geom_point(color = "maroon", size = 3, alpha = 0.7) +
theme_bw() +
labs(title = paste("Avalanche Players:", input$y_var, "vs", input$x_var),
x = input$x_var,
y = input$y_var)
# Convert ggplot to an interactive plotly object (Interactive Feature 2: Tooltips)
ggplotly(p, tooltip = c("text", "x", "y"))
})
}
# Run the application
shinyApp(ui = ui, server = server)
